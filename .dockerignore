# Deny by default: private runtime/evidence/unrelated root assets never enter context.
**
!Dockerfile
!.dockerignore
!apps/
!apps/api/
!apps/api/go.mod
!apps/api/go.sum
!apps/api/cmd/
!apps/api/cmd/**
!apps/api/internal/
!apps/api/internal/**
!apps/api/migrations/
!apps/api/migrations/**
!apps/api/fixtures/
!apps/api/fixtures/embed.go
!apps/api/fixtures/catalog.json
!apps/web/
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
# Defense in depth after source inclusions.
**/*_test.go
**/*.test.ts
**/*.test.tsx
**/test-fixtures.ts
**/test-setup.ts
**/.git/**
**/.atl/**
**/backups/**
**/odd/**
**/.env*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.crt
**/.cache/**
**/node_modules/**
**/dist/**
**/evidence/**
**/runtime/**
